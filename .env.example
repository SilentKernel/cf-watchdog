# Cloudflare API token with Zone:Read and Zone Settings:Read permissions
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID where alerts are sent (use @userinfobot to find yours)
TELEGRAM_CHAT_ID=

# How often to run the audit, in hours (default: 6)
CHECK_INTERVAL_HOURS=6

# Where to store JSON snapshots (default: ./snapshots)
SNAPSHOTS_DIR=./snapshots

# Optional: healthchecks.io ping URL. The script pings /start before each cycle,
# the base URL on success, and /fail on errors. Leave blank to disable.
HEALTHCHECKS_URL=
