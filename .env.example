# Cloudflare API token. Required read scopes on the zones you watch:
#   Zone:Read, Zone Settings:Read, Cache Settings:Read,
#   Page Rules:Read, Zone WAF:Read
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID where alerts are sent (use @userinfobot to find yours)
TELEGRAM_CHAT_ID=

# How often to run the audit, in hours (default: 6)
CHECK_INTERVAL_HOURS=6

# Where to store JSON snapshots (default: ./snapshots)
SNAPSHOTS_DIR=./snapshots

# Seconds to wait between Cloudflare API requests (default: 2.0)
CLOUDFLARE_REQUEST_DELAY=2.0

# Optional: healthchecks.io ping URL. The script pings /start before each cycle,
# the base URL on full success (cloudflare + telegram both worked end-to-end),
# and /fail on any error. Leave blank to disable.
HEALTHCHECKS_URL=
